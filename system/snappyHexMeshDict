FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh on;
snap            on;
addLayers       off;

geometry
{
    buildings
    {
        type triSurface;
        file "boneco.stl";
    }

    refinementBox
    {
        type box;
        min  (  0   0   0);
        max  (  3   3   1);
    }
};

castellatedMeshControls
{
    features
    (
      { file  "boneco.eMesh"; level 3; }
    );

    refinementSurfaces
    {
        buildings
        {
            level (2 2);
            patchInfo { type wall; }
        }
    }

    refinementRegions
    {
        // refinementBox
        // {
        //     mode    inside;
        //     level   2;
        // }
    }

    insidePoint (0 0 0.1);
}

snapControls
{
    explicitFeatureSnap    true;
    implicitFeatureSnap    false;
}

addLayersControls
{
    layers
    {
        "CAD.*"
        {
            nSurfaceLayers 2;
        }
    }

    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.5;
    minThickness        1e-3;
}

meshQualityControls
{}

writeFlags
(
    // scalarLevels
    // layerSets
    // layerFields
);

mergeTolerance 1e-6;

