FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   25;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.5;

functions
{
    #includeFunc residuals(p_rgh, U, h, k, epsilon)
    #includeFunc patchFlowRate(patch=dutoEsquerdo, name=vazaoSaida)
    #includeFunc patchFlowRate(patch=dutoDireito, name=vazaoEntrada)
    #includeFunc volAverage(T)
    #includeFunc wallHeatFlux
}


