FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [dynamicDiffusivity];

internalField   uniform 0;

boundaryField
{
    "(paredes|paredesDuto|boneco)"
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
    }



    dutoDireito
    {
        type            calculated;
        value           uniform 0;
    }

    dutoEsquerdo
    {
        type            calculated;
        value      uniform 0;
    }

    "(front|back)"
    {
        type            empty;
    }

}


