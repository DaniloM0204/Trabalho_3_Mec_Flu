FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [turbulentOmega];

internalField   uniform 0.998;

boundaryField
{
    "(paredes|paredesDuto|boneco)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }

    dutoDireito
    {
        type              turbulentOmega;
        mixingLength                0.07;
        value             $internalField;
    }

    dutoEsquerdo
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    "(front|back)"
    {
        type            empty;
    }
}


