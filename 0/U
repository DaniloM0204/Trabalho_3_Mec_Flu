FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (0 0 0);

boundaryField
{
    paredes
    {
        type            noSlip;
    }

    boneco
    {
        type            noSlip;
    }

    dutoDireito
    {
        type            fixedValue;
        value           uniform (-0.75 0 0);
    }

    dutoEsquerdo
    {
        type            pressureInletOutletVelocity;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}


