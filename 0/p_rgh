FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [pressure];

internalField   uniform 0;

boundaryField
{
    paredes
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

        paredesDuto
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    boneco
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    dutoEsquerdo
    {
        type            fixedValue;
        value           uniform 0;
    }

    dutoDireito
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}

