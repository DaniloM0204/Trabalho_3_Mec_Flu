FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [turbulentKineticEnergy];

internalField   uniform 1.44e-3;

boundaryField
{
    "(paredes|paredesDuto|boneco)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    dutoDireito
    {
        type            turbulentKineticEnergy;
        intensity       0.0413;
        value           $internalField;
    }

    dutoEsquerdo
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    "(front|back)"
    {
        type            empty;
    }

}


