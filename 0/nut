FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [turbulentViscosity];

internalField   uniform 0;

boundaryField
{
    paredes
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    boneco
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    dutoDireito
    {
        type            calculated;
        value           uniform 0;
    }

    dutoEsquerdo
    {
        type            calculated;
        value      uniform 0;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}


