FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   uniform 298.15;

boundaryField
{
    paredes
    {
        type            fixedValue;
        value           uniform 298.15;
    }

    boneco
    {
        type            fixedValue;
        value           uniform 303.15;
    }

    dutoDireito
    {
        type            fixedValue;
        value           uniform 288.15;
    }

    dutoEsquerdo
    {
        type            zeroGradient;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }

}


